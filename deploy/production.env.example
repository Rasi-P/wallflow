# Copy to .env.production and keep that file private.
WALLFLOW_ORIGIN=https://wallflow.example.com
DJANGO_SECRET_KEY=

# Google OAuth Web application. Register WALLFLOW_ORIGIN + /api/v1/auth/google/callback/.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing managed PostgreSQL database. Use the hostname on its TLS certificate.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=wallflow
POSTGRES_USER=wallflow
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=system
