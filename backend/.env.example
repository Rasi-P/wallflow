# Generate this locally with the command in backend/README.md.
DJANGO_SECRET_KEY=
WALLFLOW_ORIGIN=http://localhost:8002
WALLFLOW_AUTH_PREVIEW=true

POSTGRES_DB=wallflow
POSTGRES_USER=wallflow
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Copy the credentials from a Google OAuth Web application client.
# Register http://localhost:8002/api/v1/auth/google/callback/ for this origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
